# Explicit Stripe mode: test (default) or live. Parent supplies secrets separately.
STX_BILLING_PROVIDER=stripe
STX_STRIPE_MODE=test
# Separate durable database paths per mode; never copy test balances into live.
STX_BILLING_DATABASE=var/billing-test.sqlite3
STX_CHECKOUT_ORIGIN=https://statement-to-excel.apps.smolkin.org
# localhost origin permitted only in test mode.
# STX_STRIPE_SECRET_KEY=        # matching sk_test_ or sk_live_ from secret store
# STX_STRIPE_WEBHOOK_SECRET=    # matching mode endpoint; signed snapshots 2026-08-26.dahlia (HTTP stays 2026-02-25.clover)
# STX_STRIPE_PORTAL_CONFIGURATION=  # REQUIRED with both secrets: app/mode-specific bpc_; see runbook
# Missing keys preserve unmetered conversion; invalid/mismatched values fail closed.
# Never commit secrets. Parent handles real test payments/live checkout inspection.

# Optional PUBLIC frontend build values, tracked in frontend/.env.production.
# Empty => not loaded; BOTH providers also require the new explicit optional consent.
# Fresh nested frontend builds read that file without environment forwarding.
# Only verified provider IDs/tokens; no credentials, fake destinations or guessed IDs.
# Parent must disable GA Enhanced Measurement in the stream before configuring ID.
# VITE_GA_MEASUREMENT_ID=
# VITE_CF_WEB_ANALYTICS_TOKEN=

# Frontend build: empty means same-origin /api; production needs an API reverse proxy.
# VITE_API_BASE=https://your-api-origin.example
# Vite dev/preview proxy target (does not configure production hosting):
STX_API_TARGET=http://127.0.0.1:8000

# Optional API conversion wall deadline (seconds): finite >0 and <=120; default 30.
# STX_CONVERSION_TIMEOUT_SECONDS=30
