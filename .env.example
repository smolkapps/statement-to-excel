# statement-to-excel — environment configuration (copy to .env)

# ---- Backend -------------------------------------------------------------
# Billing provider. "mock" (default) runs fully offline with an in-memory
# ledger — the whole purchase->grant flow works and is unit-tested with no
# external service. Set to a real provider once integrated (not in this build).
STX_BILLING_PROVIDER=mock

# When a real payment provider is wired in, its secret goes here (kept OUT of
# git via .gitignore). Left blank in the mock build.
# STRIPE_SECRET_KEY=

# ---- Frontend (Vite) -----------------------------------------------------
# Base URL of the backend API. Empty = same-origin (use a dev proxy locally).
# VITE_API_BASE=http://127.0.0.1:8000
