# Backend: Stripe test mode is the only supported deployment provider.
# Checkout remains unavailable until test keys and the signed webhook are configured.
STX_BILLING_PROVIDER=stripe
STX_BILLING_DATABASE=var/billing.sqlite3
STX_CHECKOUT_ORIGIN=http://localhost:5173
# STX_STRIPE_SECRET_KEY=        # Supply an sk_test_ key via the service secret store.
# STX_STRIPE_WEBHOOK_SECRET=    # Supply the Stripe test endpoint's whsec_ secret.
# Never commit keys. Live keys/events are rejected until Michael approves live charges.

# Frontend build: empty means same-origin /api; production needs an API reverse proxy.
# VITE_API_BASE=https://your-api-origin.example
# Vite dev/preview proxy target (does not configure production hosting):
STX_API_TARGET=http://127.0.0.1:8000
